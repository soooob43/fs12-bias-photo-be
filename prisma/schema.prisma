generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============================
// Enums
// ==============================

/// 로그인 유형
enum Provider {
  /// 로컬 로그인
  LOCAL  @map("local")
  /// 구글 로그인
  GOOGLE @map("google")
}

/// 카드 등급
enum CardGrade {
  COMMON
  RARE
  SUPER_RARE
  LEGENDARY
}

/// 카드 장르
enum CardGenre {
  ALBUM           @map("앨범")
  BENEFIT         @map("특전")
  FAN_SIGN        @map("팬싸")
  SEASON_GREETING @map("시즌그리팅")
  FAN_MEETING     @map("팬미팅")
  CONCERT         @map("콘서트")
  MD              @map("MD")
  COLLAB          @map("콜라보")
  FAN_CLUB        @map("팬클럽")
  ETC             @map("기타")
}

/// 보유 카드 현재 상태
enum OwnershipStatus {
  /// 보유중
  IN_GALLERY
  /// 판매중
  ON_SALE
  /// 교환 제시중
  ON_EXCHANGE
}

/// 알림 유형
enum NotificationType {
  /// 교환 제안 알림
  EXCHANGE_OFFER
  /// 교환 수락 알림
  EXCHANGE_ACCEPTED
  /// 교환 취소 알림
  EXCHANGE_REJECTED
  /// 구매 완료 알림
  PURCHASE_COMPLETED
  /// 판매 완료 알림
  SALE_COMPLETED
  /// 품절 알림
  SOLD_OUT
}

/// 포인트 변경 유형
enum PointHistoryType {
  /// 랜덤 박스
  RANDOM_BOX
  /// 구매
  PURCHASE
  /// 판매
  SALE
}

/// 거래 내역 유형
enum TransactionHistoryType {
  /// 교환
  EXCHANGE
  /// 거래
  TRADE
}

// ==============================
// Models
// ==============================

/// 사용자 정보 테이블
model User {
  id           String   @id @default(uuid()) @db.Uuid
  /// 이메일
  email        String   @unique
  /// 닉네임
  nickname     String
  /// 비밀번호
  password     String?
  /// 로그인 방식
  provider     Provider @default(LOCAL)
  /// 구글 OAUTH 제공 id
  providerId   String?  @map("provider_id")
  /// refresh 토큰(JWT)
  refreshToken String?  @map("refresh_token")
  /// 생성 날짜
  createdAt    DateTime @default(now()) @map("created_at")
  /// 수정 날짜
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  createdCards       Card[]               @relation("CardCreator")
  ownedCards         CardOwnership[]      @relation("CardOwner")
  sales              Transaction[]        @relation("TransactionSeller")
  exchangeOffers     ExchangeOffer[]      @relation("ExchangeProposer")
  notifications      Notification[]
  point              UserPoint?           
  pointHistories     PointHistory[]
  randomBoxes        RandomBox[]
  salesHistories     TransactionHistory[] @relation("HistorySeller")
  purchasesHistories TransactionHistory[] @relation("HistoryBuyer")

  @@map("users")
}

/// 포토카드 도안 테이블
model Card {
  id            Int       @id @default(autoincrement())
  /// 포토카드 생성자 아이디
  creatorId     String    @map("creator_id") @db.Uuid
  /// 포토카드 제목
  title         String
  /// 포토카드 이미지 URL
  imageUrl      String    @map("image_url")
  /// 포토카드 설명
  description   String?
  /// 포토카드 등급
  grade         CardGrade
  /// 포토카드 장르
  genre         CardGenre
  /// 포토카드 최소 가격
  minimumPrice  Int       @map("minimum_price")
  /// 포토카드 총 발행량
  totalQuantity Int       @map("total_quantity")
  /// 생성 날짜
  createdAt     DateTime  @default(now()) @map("created_at")

  // Relations
  creator       User            @relation("CardCreator", fields: [creatorId], references: [id])
  ownerships    CardOwnership[]

  @@map("cards")
}

/// 포토카드 소유권 테이블
model CardOwnership {
  id            Int             @id @default(autoincrement())
  /// 포토카드 도안 아이디
  cardId        Int             @map("card_id")
  /// 포토카드 소유권자 아이디
  ownerId       String          @map("owner_id") @db.Uuid
  /// 포토카드 구매시 가격
  purchasePrice Int             @map("purchase_price")
  /// 포토카드 현재 상태
  status        OwnershipStatus
  /// 생성 날짜
  createdAt     DateTime        @default(now()) @map("created_at")
  /// 수정 날짜
  updatedAt     DateTime        @updatedAt @map("updated_at")

  // Relations
  card                 Card                 @relation(fields: [cardId], references: [id])
  owner                User                 @relation("CardOwner", fields: [ownerId], references: [id])
  transactions         Transaction[]
  exchangeOffers       ExchangeOffer[]
  transactionHistories TransactionHistory[]

  @@map("card_ownerships")
}

/// 포토카드 판매 내역 테이블
model Transaction {
  id                  Int       @id @default(autoincrement())
  /// 포토카드 판매자 아이디
  sellerId            String    @map("seller_id") @db.Uuid
  /// 판매 포토카드 아이디
  cardId              Int       @map("card_id")
  /// 포토카드 판매 가격
  price               Int       
  /// 포토카드 총 수량
  totalQuantity       Int       @map("total_quantity")
  /// 포토카드 남은 수량
  remainingQuantity   Int       @map("remaining_quantity") 
  /// 원하는 교환 카드 등급
  exchangeGrade       CardGrade @map("exchange_grade")
  /// 원하는 교환 카드 장르
  exchangeGenre       CardGenre @map("exchange_genre")
  /// 원하는 교환 카드 설명
  exchangeDescription String?   @map("exchange_description")
  /// 생성 날짜
  createdAt           DateTime  @default(now()) @map("created_at")
  /// 수정 날짜
  updatedAt           DateTime  @updatedAt @map("updated_at")
  /// 삭제 여부(판매 취소시 true)
  isDeleted           Boolean   @default(false) @map("is_deleted")

  // Relations
  seller         User            @relation("TransactionSeller", fields: [sellerId], references: [id])
  card           CardOwnership   @relation(fields: [cardId], references: [id])
  exchangeOffers ExchangeOffer[] 

  @@map("transactions")
}

/// 교환 제안 목록 테이블
model ExchangeOffer {
  id            Int      @id @default(autoincrement())
  /// 교환 요청한 포토카드 목록 아이디
  listingId     Int      @map("listing_id") 
  /// 교환 요청한 사람의 아이디
  proposerId    String   @map("proposer_id") @db.Uuid
  /// 교환 요청한 카드
  offeredCardId Int      @map("offered_card_id")
  /// 교환 카드에 대한 설명
  description   String?
  /// 생성 날짜
  createdAt     DateTime @default(now()) @map("created_at")
  /// 삭제 여부(교환 취소시 true)
  isDeleted     Boolean  @default(false) @map("is_deleted")

  // Relations
  listing       Transaction   @relation(fields: [listingId], references: [id])
  proposer      User          @relation("ExchangeProposer", fields: [proposerId], references: [id])
  offeredCard   CardOwnership @relation(fields: [offeredCardId], references: [id])

  @@map("exchange_offers")
}

/// 알림 테이블
model Notification {
  id        Int              @id @default(autoincrement())
  /// 알림 받을 아이디
  userId    String           @map("user_id") @db.Uuid
  /// 알림 유형
  type      NotificationType
  /// 알림 메시지
  message   String
  /// 알림 읽음 여부
  isRead    Boolean          @default(false) @map("is_read")
  /// 생성 날짜
  createdAt DateTime         @default(now()) @map("created_at")
  /// 삭제 여부
  isDeleted Boolean          @default(false) @map("is_deleted")

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

/// 현재 포인트 테이블
model UserPoint {
  id        Int      @id @default(autoincrement())
  /// 유저 아이디
  userId    String   @unique @map("user_id") @db.Uuid
  /// 현재 포인트
  balance   Int      @default(0)
  /// 수정 날짜
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@map("user_points")
}

/// 포인트 로그 테이블
model PointHistory {
  id        Int              @id @default(autoincrement())
  /// 유저 아이디
  userId    String           @map("user_id") @db.Uuid
  /// 변경된 포인트 (+ / -)
  amount    Int
  /// 포인트 변경된 이유
  type      PointHistoryType
  /// 생성 날짜
  createdAt DateTime         @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@map("points_histories")
}

/// 포인트 랜덤 상자 테이블
model RandomBox {
  id           Int      @id @default(autoincrement())
  /// 유저 아이디
  userId       String   @map("user_id") @db.Uuid
  /// 랜덤 상자에서 획득한 포인트
  earnedPoints Int      @map("earned_points")
  /// 랜덤 상자 오픈 시간
  lastOpenedAt DateTime @default(now()) @map("last_opened_at")

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@map("random_boxes")
}

/// 거래 내역 로그 테이블
model TransactionHistory {
  id        Int                    @id @default(autoincrement())
  /// 포토카드를 판매한 유저 아이디
  sellerId  String                 @map("seller_id") @db.Uuid
  /// 포토카드를 구매한 유저 아이디
  buyerId   String                 @map("buyer_id") @db.Uuid
  /// 거래된 포토카드 아이디
  cardId    Int                    @map("card_id")
  /// 거래 유형
  type      TransactionHistoryType
  /// 포토카드 구매 시 가격
  price     Int?
  /// 생성 날짜
  createdAt DateTime               @default(now()) @map("created_at")

  // Relations
  seller User          @relation("HistorySeller", fields: [sellerId], references: [id])
  buyer  User          @relation("HistoryBuyer", fields: [buyerId], references: [id])
  card   CardOwnership @relation(fields: [cardId], references: [id])

  @@map("transaction_histories")
}